{
  "cohort": {
    "dataset_name": "Synthetic sepsis coursework demo",
    "version": "synthetic-v2",
    "n_patients": 600,
    "time_step_hours": 4,
    "max_window_hours": 72,
    "train_ratio": 0.7,
    "val_ratio": 0.15,
    "test_ratio": 0.15,
    "random_state": 42,
    "min_age": 18,
    "sepsis_criteria": "Not clinically validated; simulated adult ICU-like observations",
    "imputation_strategy": "median",
    "scaling_strategy": "standard_scaler",
    "features": [
      "age",
      "gender",
      "elixhauser",
      "sofa_initial",
      "gcs",
      "hr",
      "sys_bp",
      "dia_bp",
      "map",
      "rr",
      "temp",
      "spo2",
      "fio2",
      "lactate",
      "creatinine",
      "platelets",
      "bilirubin",
      "wbc",
      "bun",
      "glucose",
      "potassium",
      "sodium",
      "chloride",
      "bicarbonate",
      "ph",
      "pao2",
      "paco2",
      "hemoglobin",
      "urine_output",
      "cumulated_balance"
    ]
  },
  "model": {
    "model_name": "Tabular Model-Based Offline RL",
    "algorithm": "Policy Iteration",
    "n_clusters": 75,
    "random_state": 42,
    "gamma": 0.99,
    "theta": 1e-05,
    "max_eval_iters": 1000,
    "max_pi_iters": 100,
    "min_transition_count": 5,
    "reward_alive": 100.0,
    "reward_dead": -100.0,
    "reward_step": 0.0,
    "action_space": {
      "n_actions": 25,
      "fluid_bins": 5,
      "vaso_bins": 5
    }
  },
  "evaluation": {
    "evaluation_method": "Trajectory-wise Weighted Importance Sampling",
    "behavior_policy": {
      "smoothing_method": "Laplace",
      "alpha": 0.05
    },
    "target_policy": {
      "mode": "soft",
      "recommended_prob": 0.99,
      "off_policy_prob": 0.01
    },
    "wis": {
      "weight_clip": 500.0,
      "gamma": 0.99
    },
    "bootstrap": {
      "n_bootstraps": 500,
      "resample_level": "patient",
      "confidence_level": 0.95,
      "random_state": 42
    },
    "sensitivity": {
      "alphas": [
        0.01,
        0.05,
        0.1,
        0.2
      ],
      "weight_clips": [
        100.0,
        250.0,
        500.0,
        1000.0
      ],
      "soft_probs": [
        0.95,
        0.98,
        0.99
      ]
    }
  }
}